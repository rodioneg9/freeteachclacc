<Application
    x:Class="FreeTeachClass.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:FreeTeachClass.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI 2-style control resources (NavigationView, etc.).
                     Without this entry control styles fail to resolve at startup. -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary>
                    <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />
                    <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
                    <converters:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" Invert="True" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#F6F6F9" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#E3E3E8" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#6E6E76" />
                    <SolidColorBrush x:Key="WarningTextBrush" Color="#B3261E" />
                    <SolidColorBrush x:Key="SuccessTextBrush" Color="#107C10" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2A2A2F" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#3B3B42" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#9C9CA3" />
                    <SolidColorBrush x:Key="WarningTextBrush" Color="#F1707A" />
                    <SolidColorBrush x:Key="SuccessTextBrush" Color="#6CCB5F" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="StatValueStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="FontSize" Value="28" />
            </Style>

            <Style x:Key="CaptionSecondaryStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SubtleTextBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="BodyWrapStyle" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
