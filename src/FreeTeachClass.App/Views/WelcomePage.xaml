<Page
    x:Class="FreeTeachClass.App.Views.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel
            MaxWidth="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="FreeTeachClass" />
            <TextBlock
                HorizontalAlignment="Center"
                Opacity="0.7"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Меньше мороки. Больше учёбы."
                TextWrapping="Wrap" />

            <Button
                HorizontalAlignment="Center"
                Command="{x:Bind ViewModel.ConnectCommand}"
                Content="Подключить Google Classroom"
                Style="{StaticResource AccentButtonStyle}" />

            <ProgressRing
                Width="32"
                Height="32"
                HorizontalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />

            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource WarningTextBrush}"
                Style="{StaticResource BodyWrapStyle}"
                Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                TextAlignment="Center" />

            <TextBlock
                HorizontalAlignment="Center"
                Opacity="0.6"
                Style="{StaticResource CaptionSecondaryStyle}"
                Text="{x:Bind ViewModel.HintMessage, Mode=OneWay}"
                TextAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
