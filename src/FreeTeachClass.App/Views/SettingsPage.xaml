<Page
    x:Class="FreeTeachClass.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel
            MaxWidth="700"
            Padding="24,20,24,24"
            HorizontalAlignment="Stretch"
            Spacing="16">

            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Настройки" />

            <!-- Аккаунт -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Аккаунт Google" />
                    <TextBlock Style="{StaticResource BodyWrapStyle}" Text="{x:Bind ViewModel.UserName, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="{x:Bind ViewModel.UserEmail, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- Оформление -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Оформление" />
                    <ComboBox
                        MinWidth="220"
                        SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Как в системе" />
                        <ComboBoxItem Content="Светлая тема" />
                        <ComboBoxItem Content="Тёмная тема" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- AI-помощник -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="AI-помощник" />
                    <TextBlock
                        Style="{StaticResource CaptionSecondaryStyle}"
                        Text="Ключ хранится только на этом компьютере в зашифрованном виде (Windows DPAPI) и отправляется напрямую выбранному провайдеру." />

                    <ComboBox
                        HorizontalAlignment="Stretch"
                        DisplayMemberPath="Name"
                        Header="Провайдер"
                        ItemsSource="{x:Bind ViewModel.AiProviders}"
                        SelectedItem="{x:Bind ViewModel.SelectedAiProvider, Mode=TwoWay}" />

                    <ComboBox
                        HorizontalAlignment="Stretch"
                        Header="Модель"
                        IsEditable="True"
                        ItemsSource="{x:Bind ViewModel.AiModels, Mode=OneWay}"
                        Text="{x:Bind ViewModel.AiModel, Mode=TwoWay}" />

                    <TextBox
                        HorizontalAlignment="Stretch"
                        Header="Base URL (для своего OpenAI-совместимого сервиса)"
                        Text="{x:Bind ViewModel.AiBaseUrl, Mode=TwoWay}"
                        Visibility="{x:Bind ViewModel.IsCustomProvider, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />

                    <PasswordBox
                        x:Name="AiKeyBox"
                        HorizontalAlignment="Stretch"
                        Header="API-ключ"
                        PasswordChanged="OnAiKeyPasswordChanged"
                        PlaceholderText="Вставьте ключ и нажмите «Сохранить ключ»" />

                    <TextBlock
                        Style="{StaticResource CaptionSecondaryStyle}"
                        Text="{x:Bind ViewModel.AiKeyHint, Mode=OneWay}" />

                    <HyperlinkButton
                        Content="Где получить ключ"
                        NavigateUri="{x:Bind ViewModel.AiKeyUri, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasAiKeyUri, Mode=OneWay, Converter={StaticResource BooleanToVisibility}}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Command="{x:Bind ViewModel.SaveAiSettingsCommand}"
                            Content="Сохранить настройки" />
                        <Button Click="OnSaveAiKeyClick" Content="Сохранить ключ" />
                        <Button Click="OnTestAiKeyClick" Content="Проверить" />
                        <Button Click="OnDeleteAiKeyClick" Content="Удалить ключ" />
                    </StackPanel>

                    <ProgressRing
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Left"
                        IsActive="{x:Bind ViewModel.IsAiBusy, Mode=OneWay}" />

                    <TextBlock
                        Style="{StaticResource CaptionSecondaryStyle}"
                        Text="{x:Bind ViewModel.AiKeyStatus, Mode=OneWay}" />

                    <TextBlock
                        Style="{StaticResource BodyWrapStyle}"
                        Text="{x:Bind ViewModel.AiStatusMessage, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.AiStatusMessage, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Данные -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Данные" />
                    <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="{x:Bind ViewModel.LastSyncText, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind ViewModel.RefreshDataCommand}" Content="Обновить данные" />
                        <Button Command="{x:Bind ViewModel.SignOutCommand}" Content="Выйти из аккаунта" />
                    </StackPanel>
                    <ProgressRing
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Left"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource BodyWrapStyle}" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- О приложении -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="О приложении" />
                    <TextBlock Style="{StaticResource BodyWrapStyle}" Text="FreeTeachClass — учебный проект. Данные берутся только из официального Google Classroom API." />
                    <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="Пароль Google не хранится. Токены хранятся в защищённом хранилище Windows (DPAPI)." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
