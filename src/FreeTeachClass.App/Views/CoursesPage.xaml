<Page
    x:Class="FreeTeachClass.App.Views.CoursesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FreeTeachClass.App.ViewModels">

    <ScrollViewer>
        <StackPanel
            MaxWidth="1100"
            Padding="24,20,24,24"
            HorizontalAlignment="Stretch"
            Spacing="16">

            <Grid>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Предметы" />
                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Content="Обновить" />
            </Grid>

            <TextBlock
                Foreground="{ThemeResource WarningTextBrush}"
                Style="{StaticResource BodyWrapStyle}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}" />

            <TextBlock
                Opacity="0.6"
                Style="{StaticResource BodyWrapStyle}"
                Text="Курсы пока не загружены. Нажмите «Обновить»."
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Courses, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CourseItemViewModel">
                        <Border Margin="0,0,0,8" Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="{x:Bind Subtitle}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource SubtleTextBrush}"
                                    Text="{x:Bind AssignmentCountText}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
