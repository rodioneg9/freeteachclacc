<Page
    x:Class="FreeTeachClass.App.Views.AssignmentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FreeTeachClass.App.Controls"
    xmlns:vm="using:FreeTeachClass.App.ViewModels">

    <ScrollViewer>
        <StackPanel
            MaxWidth="1100"
            Padding="24,20,24,24"
            HorizontalAlignment="Stretch"
            Spacing="16">

            <Grid>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Задания" />
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Spacing="8">
                    <ComboBox
                        MinWidth="180"
                        ItemsSource="{x:Bind ViewModel.CourseFilters, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedCourseFilter, Mode=TwoWay}"
                        DisplayMemberPath="Name" />
                    <Button Command="{x:Bind ViewModel.RefreshCommand}" Content="Обновить" />
                </StackPanel>
            </Grid>

            <TextBlock
                Foreground="{ThemeResource WarningTextBrush}"
                Style="{StaticResource BodyWrapStyle}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibility}}" />

            <TextBlock
                Opacity="0.6"
                Style="{StaticResource BodyWrapStyle}"
                Text="Задания не найдены. Нажмите «Обновить», чтобы загрузить их из Google Classroom."
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Assignments, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AssignmentItemViewModel">
                        <Border Margin="0,0,0,8" Style="{StaticResource CardStyle}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <controls:LinkTextBlock
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Title}" />
                                    <TextBlock Style="{StaticResource CaptionSecondaryStyle}" Text="{x:Bind CourseName}" />
                                    <TextBlock
                                        Opacity="0.8"
                                        Style="{StaticResource BodyWrapStyle}"
                                        Text="{x:Bind DescriptionPreview}"
                                        Visibility="{x:Bind DescriptionPreview, Converter={StaticResource NullOrEmptyToVisibility}}" />
                                    <TextBlock
                                        Style="{StaticResource CaptionSecondaryStyle}"
                                        Text="{x:Bind MaterialsText}"
                                        Visibility="{x:Bind MaterialsText, Converter={StaticResource NullOrEmptyToVisibility}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
                                    <TextBlock
                                        Foreground="{ThemeResource SubtleTextBrush}"
                                        Text="{x:Bind DueText}" />
                                    <HyperlinkButton
                                        HorizontalAlignment="Right"
                                        Command="{x:Bind OpenCommand}"
                                        Content="Подробнее" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
